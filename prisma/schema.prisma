generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  cpf          String?  @unique
  referralCode String   @unique
  referredById String?
  createdAt    DateTime @default(now())

  // Vendedor: papel especial (só atribuído via SQL direto — sem
  // autoatendimento) e o vínculo cliente→vendedor, independente da
  // indicação entre amigos acima. Um cliente pode ter os dois ao mesmo
  // tempo — o amigo e o vendedor ganham comissão juntos, cada um a sua
  // taxa (ver creditReferralCommission/creditVendedorCommission em
  // lib/orders/orderCore.ts). Uma vez setado, vendedorId não muda mais
  // (trava no primeiro vínculo, ver attributeCode em lib/userAccount.ts).
  isVendedor Boolean @default(false)
  vendedorId String?

  // Telefone e nascimento — exigidos pelo checkout (efetuar-venda-v1 da
  // Trier/SGF precisa dos dois no `cliente`).
  phone     String?
  birthDate DateTime? @db.Date

  // Endereço — mesmo formato do ClienteEcommerceIntegracaoDto da Trier,
  // pra não precisar converter na hora do checkout.
  cep         String?
  estado      String?
  cidade      String?
  logradouro  String?
  numero      String?
  bairro      String?
  complemento String?

  // Saúde — usado em recomendações e alertas de segurança na hora da
  // compra (ex: interação de medicamento com alergia/condição informada).
  heightCm   Int?
  conditions String[] @default([])
  allergies  String[] @default([])

  cart                 Cart?
  orders               Order[]
  referredBy           User?                @relation("Referrals", fields: [referredById], references: [id])
  referrals            User[]               @relation("Referrals")
  vendedor             User?                @relation("VendedorClientes", fields: [vendedorId], references: [id])
  clientesVendidos     User[]               @relation("VendedorClientes")
  careLinksAsTitular   CareLink[]           @relation("TitularLinks")
  careLinksAsCaregiver CareLink[]           @relation("CaregiverLinks")
  healthMeasurements   HealthMeasurement[]
  timelineEvents       TimelineEvent[]
  careChecklistItems   CareChecklistItem[]
  timelineReactions    TimelineReaction[]
  timelineComments     TimelineComment[]
  pushSubscriptions    PushSubscription[]
  walletEntries        WalletEntry[]
  loyaltyStampCycles   LoyaltyStampCycle[]
  medicationTrackings  MedicationTracking[]
  expoPushTokens       ExpoPushToken[]
  goals                Goal[]
}

enum WalletEntrySource {
  // Sem uso — o modelo mudou pra comissão por compra antes de este bônus
  // fixo entrar em produção de verdade. Mantido no enum porque remover um
  // valor exige recriar o tipo no Postgres; não vale o risco só por isso.
  REFERRAL_SIGNUP
  REFERRAL_PURCHASE_COMMISSION
  LOYALTY_STAMP_REWARD
  VENDEDOR_PURCHASE_COMMISSION
  WALLET_REDEMPTION
}

// Extrato de crédito do usuário (hoje só bônus de indicação; comissão por
// compra do indicado entra aqui também assim que o checkout existir) — sem
// saque/pagamento automático ainda, só acúmulo visível.
model WalletEntry {
  id          String            @id @default(cuid())
  userId      String
  amountCents Int
  source      WalletEntrySource
  description String
  createdAt   DateTime          @default(now())

  user User @relation(fields: [userId], references: [id])
}

// Cartão fidelidade: 1 selo por pedido aprovado >= LOYALTY_MIN_ORDER_CENTS
// (ver lib/loyalty/loyaltyCore.ts). Uma linha aqui = 1 ciclo de 10 selos já
// premiado — existe só pra idempotência (igual CareChecklistCompletion):
// sem isso, um retry de aprovação de pedido creditaria o prêmio duas vezes.
model LoyaltyStampCycle {
  id          String   @id @default(cuid())
  userId      String
  cycleNumber Int
  rewardCents Int
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, cycleNumber])
}

enum CareLinkStatus {
  PENDING
  ACTIVE
  REVOKED
}

model CareLink {
  id          String         @id @default(cuid())
  titularId   String
  caregiverId String?
  inviteCode  String         @unique
  status      CareLinkStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  acceptedAt  DateTime?

  titular   User  @relation("TitularLinks", fields: [titularId], references: [id])
  caregiver User? @relation("CaregiverLinks", fields: [caregiverId], references: [id])
}

// Espelho "write-through" do catálogo real da farmácia (banco externo, ver
// lib/catalog/catalogDb.ts) — não é mais uma tabela curada à mão. Toda vez
// que o app toca um produto (navegar, ver detalhe, adicionar ao carrinho,
// fechar pedido), busca ao vivo na origem e sobrescreve a linha aqui,
// chaveada por codigoProduto. Existe só porque CartItem/OrderItem precisam
// de uma FK local de verdade — não dá pra ter FK entre bancos diferentes.
// name sem @unique (nome de origem não garante isso) e description
// opcional (não existe coluna equivalente na origem) por causa disso.
model Product {
  id                  String                 @id @default(cuid())
  name                String
  description         String?
  priceCents          Int
  // Custo do produto — usado só server-side pra calcular comissão de
  // indicação (2% da margem bruta). Nullable: sem custo definido, a
  // comissão daquele item é pulada, nunca estimada. Vem de custo_medio no
  // espelho a partir do catálogo real.
  costCents           Int?
  imageUrl            String
  stock               Int                    @default(0)
  codigoProduto       Int?                   @unique
  // Slug já mapeado (ver constants/catalogCategories.ts), não mais um
  // enum fixo — a taxonomia de vitrine é curada em código a partir do
  // "grupo" de origem, não corresponde a MEDICAMENTO/PRODUTO de antes.
  category            String?
  usoContinuo         Boolean                @default(false)
  duracaoEstimadaDias Int?
  healthCheckType     HealthMeasurementType?
  createdAt           DateTime               @default(now())

  cartItems  CartItem[]
  orderItems OrderItem[]
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  ONLINE_MP
  CARTAO_PRESENCIAL
  DINHEIRO
}

model Order {
  id     String      @id @default(cuid())
  userId String
  status OrderStatus @default(PENDING)

  // subtotalCents é o valor bruto dos itens, nunca muda — é sobre esse
  // valor que o cartão fidelidade qualifica o pedido (ver
  // checkLoyaltyStampReward em lib/loyalty/loyaltyCore.ts), pra resgatar
  // saldo não fazer o cliente "perder" o selo de uma compra grande.
  // totalCents é o valor cobrado de fato (subtotalCents - walletDiscountCents)
  // — o mesmo reportado pra Trier. walletDiscountCents muda de sentido em
  // duas fases: desconto pedido enquanto PENDING, desconto efetivamente
  // debitado da carteira quando aprovado (ver approveOrder).
  subtotalCents      Int
  totalCents         Int
  walletDiscountCents Int @default(0)

  // paymentMethod nunca cai no @default abaixo na prática — a aplicação
  // sempre exige um valor explícito (ver createOrderForItems), o default
  // é só rede de segurança pra migration de linhas já existentes. Cartão
  // presencial e dinheiro aprovam o pedido na hora da criação (pagamento
  // acontece fisicamente, fora do controle do app); só ONLINE_MP fica
  // PENDING esperando o webhook do Mercado Pago.
  paymentMethod     PaymentMethod   @default(CARTAO_PRESENCIAL)
  cashTenderedCents Int?
  mpPaymentId       String?
  mpPreferenceId    String?
  mpStatus          String?
  mpError           String?
  fulfillmentType   FulfillmentType @default(PICKUP)
  addressCep        String?
  addressLogradouro String?
  addressNumero     String?
  addressBairro     String?
  addressCidade     String?
  addressEstado     String?
  trierNumeroNota   Int?
  trierSyncedAt     DateTime?
  trierError        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user               User                @relation(fields: [userId], references: [id])
  items              OrderItem[]
  healthMeasurements HealthMeasurement[]
}

enum HealthMeasurementType {
  PRESSAO
  PESO
  GORDURA
  GLICEMIA
}

model HealthMeasurement {
  id                String                @id @default(cuid())
  userId            String
  type              HealthMeasurementType
  pressaoSistolica  Int?
  pressaoDiastolica Int?
  pesoKg            Float?
  percentualGordura Float?
  glicemiaMgDl      Int?
  local             String
  measuredAt        DateTime
  orderId           String?
  createdAt         DateTime              @default(now())

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  unitPriceCents Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

enum TimelineEventType {
  ACHIEVEMENT_WEIGHT
  ACHIEVEMENT_PRESSURE
  ACHIEVEMENT_CARE_COMPLETE
  ACHIEVEMENT_WEIGHT_MILESTONE
  ACHIEVEMENT_GLICEMIA
  ACHIEVEMENT_ROUTINE_STREAK
  ACHIEVEMENT_REFERRAL_MILESTONE
}

// Corresponde a uma meta em escada (peso perdido, dias seguidos de rotina,
// amigos indicados): cada degrau batido é único por usuário+tipo+degrau,
// pra não gerar a mesma conquista duas vezes.
enum GoalType {
  PESO
  ROTINA
  INDICACAO
}

model TimelineEvent {
  id         String            @id @default(cuid())
  userId     String
  type       TimelineEventType
  title      String
  message    String
  occurredAt DateTime          @default(now())
  createdAt  DateTime          @default(now())
  // null = privada (só o dono vê). Preenchida quando o dono clica em
  // "Compartilhar" — consentimento explícito exigido pela LGPD pra dado de
  // saúde (dado sensível). Também usada pra ordenar o feed público.
  sharedAt   DateTime?

  // Presentes só nas conquistas de meta em escada (peso/rotina) — dado bruto
  // do degrau (ex: 5kg, 60 dias) e o índice do estágio do bichinho, pra não
  // recalcular a partir do histórico toda vez que a postagem é exibida.
  goalType       GoalType?
  milestoneValue Float?
  stage          Int?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, goalType, milestoneValue])
  @@index([userId, occurredAt])
  @@index([sharedAt])
}

enum CareCategory {
  TREINO
  ALIMENTACAO
  ESTUDOS
  MEDICACAO
  TERAPIA
  OUTRO
}

model CareChecklistItem {
  id         String       @id @default(cuid())
  userId     String
  title      String
  category   CareCategory @default(OUTRO)
  // "HH:mm" em horário de Brasília; null = sem lembrete/horário fixo.
  timeOfDay  String?
  // 0=domingo..6=sábado; lista vazia = todo dia.
  daysOfWeek Int[]        @default([])
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())

  // Presente quando esse item é uma dose de medicamento controlado (ver
  // MedicationTracking) — um item por horário de dose, todos ligados à
  // mesma ficha. Null pros itens de rotina normais (treino, estudo, etc).
  medicationTrackingId String?

  user               User                      @relation(fields: [userId], references: [id])
  medicationTracking MedicationTracking?       @relation(fields: [medicationTrackingId], references: [id])
  completions        CareChecklistCompletion[]
  reminderDispatches CareReminderDispatch[]
  goals              Goal[]
}

// Ficha de acompanhamento de um medicamento comprado — quantidade total,
// posologia e a data da compra de origem, pra estimar quando acaba. Cada
// horário de dose vira um CareChecklistItem próprio (linkado aqui), o que
// reaproveita toda a engine de checklist/streak/lembrete já existente sem
// precisar dar suporte a múltiplos horários por item.
model MedicationTracking {
  id            String   @id @default(cuid())
  userId        String
  productName   String
  codigoProduto Int?
  purchaseDate  DateTime
  totalUnits    Int
  unitsPerDose  Int
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  user           User                        @relation(fields: [userId], references: [id])
  checklistItems CareChecklistItem[]
  alerts         MedicationRepurchaseAlert[]
}

// Idempotência do aviso "vai acabar amanhã" — um por ficha (não por dia,
// já que é um evento único no ciclo de vida daquela compra).
model MedicationRepurchaseAlert {
  id                   String   @id @default(cuid())
  medicationTrackingId String
  sentAt               DateTime @default(now())

  tracking MedicationTracking @relation(fields: [medicationTrackingId], references: [id])

  @@unique([medicationTrackingId])
}

model ExpoPushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

enum GoalMetric {
  PESO
  PRESSAO
  ROTINA
}

// Meta declarada pelo usuário com alvo e prazo — diferente das escadas
// automáticas de GoalType/GOAL_LADDERS (achievements.ts), que não têm
// prazo e olham o histórico inteiro. Os dois sistemas convivem sem se
// tocar. baselineValue é o peso registrado no momento da criação da meta
// (não o primeiro peso já registrado, que é o que a escada automática
// usa) — só usado quando metric = PESO. checklistItemId só é usado
// quando metric = ROTINA: a meta cria um CareChecklistItem de verdade
// por baixo e mede progresso pelas conclusões dele.
model Goal {
  id              String     @id @default(cuid())
  userId          String
  metric          GoalMetric
  title           String
  targetValue     Float?
  baselineValue   Float?
  startDate       DateTime   @db.Date
  endDate         DateTime   @db.Date
  checklistItemId String?
  createdAt       DateTime   @default(now())

  user          User               @relation(fields: [userId], references: [id])
  checklistItem CareChecklistItem? @relation(fields: [checklistItemId], references: [id])
  tipDispatches GoalTipDispatch[]

  @@index([userId, endDate])
}

// Idempotência do envio de dicas — evita reenviar a mesma dica (mesmo
// índice) duas vezes se o cron rodar mais de uma vez no período devido,
// igual CareReminderDispatch/MedicationRepurchaseAlert.
model GoalTipDispatch {
  id       String   @id @default(cuid())
  goalId   String
  tipIndex Int
  sentAt   DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, tipIndex])
}

model CareChecklistCompletion {
  id          String   @id @default(cuid())
  itemId      String
  date        DateTime @db.Date
  completedAt DateTime @default(now())

  item CareChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, date])
}

// Evita reenviar o mesmo lembrete duas vezes no dia (idempotência, igual
// já fazemos em CareChecklistCompletion e syncOrderStatus).
model CareReminderDispatch {
  id     String   @id @default(cuid())
  itemId String
  date   DateTime @db.Date
  sentAt DateTime @default(now())

  item CareChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, date])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// Curtir/comentar na timeline é pessoal (só o próprio dono vê e reage ao seu
// feed, não é social entre usuários) — por isso não há relação com outros
// usuários, só o dono. `itemKey` identifica tanto conquistas reais
// (usa o id do TimelineEvent) quanto cards de conteúdo do dia, que não são
// linhas no banco (usa uma chave sintética tipo "fact-2026-08-17").
model TimelineReaction {
  id        String   @id @default(cuid())
  userId    String
  itemKey   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, itemKey])
}

model TimelineComment {
  id        String   @id @default(cuid())
  userId    String
  itemKey   String
  text      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, itemKey])
}
